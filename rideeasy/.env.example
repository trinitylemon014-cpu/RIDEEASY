# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
PORT=5000
HOST=0.0.0.0

# Turso Production Database (libSQL)
# Get your database URL and token from Turso CLI: turso db show <db-name> --url
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# External API Integrations (Optional)
# GOOGLE_MAPS_API_KEY=
# MTN_MOMO_PRIMARY_KEY=
# AIRTEL_MONEY_CLIENT_ID=
